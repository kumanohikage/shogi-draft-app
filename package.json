{
  "name": "draft-app",
  "version": "1.0.2",
  "private": true,
  "description": "将棋のドラフト会議を1台のPCで進行・演出するアプリ",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "css": "tailwindcss -c tailwind.config.js -i ui/control.src.css -o public/control.css --minify",
    "check:ui": "npm run css && electron scripts/check-ui.js",
    "test": "node test/core.test.js && node test/store.test.js",
    "dist": "npm run vendor && npm run css && electron-builder --win",
    "dist:mac": "npm run vendor && npm run css && electron-builder --mac --publish never",
    "vendor": "node scripts/vendor.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/shippori-mincho-b1": "^5.3.0",
    "@fontsource/yuji-syuku": "^5.3.1",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "axe-core": "^4.14.0",
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3",
    "melta-ds-mcp": "^1.9.1",
    "tailwindcss": "^3.4.19",
    "three": "^0.170.0"
  },
  "build": {
    "appId": "jp.kumanohikage.draftapp",
    "productName": "ドラフト会議アプリ",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "store.js",
      "public/**/*",
      "demo.js"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "DraftApp-${version}.exe"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "DraftApp-${version}-mac-${arch}.${ext}"
    }
  },
  "author": "熊乃ヒカゲ (kumanohikage)",
  "license": "MIT",
  "repository": "https://github.com/kumanohikage/shogi-draft-app"
}
